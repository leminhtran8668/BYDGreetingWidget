<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kích hoạt ứng dụng"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ứng dụng cần mã kích hoạt để sử dụng. Gửi \"Mã thiết bị\" bên dưới cho người bán để nhận \"Mã kích hoạt\"."
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mã thiết bị của bạn:"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:background="@drawable/dialog_background"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:text="—" />

        <Button
            android:id="@+id/btn_copy_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sao chép mã thiết bị" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nhập mã kích hoạt:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_license_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="VD: A1B2-C3D4-E5F6-A7B8"
            android:inputType="textCapCharacters"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_activate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kích hoạt" />

        <TextView
            android:id="@+id/tv_license_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
